<Page
    x:Class="PhotoAIFactory.App.Pages.JobDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoAIFactory.Application.UI"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="0,0,0,40">
            <!-- Top Nav -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.JobDetail.PhotoName, Mode=OneWay, FallbackValue='Job Details'}" Style="{ThemeResource TitleTextBlockStyle}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}"/>
            </Grid>

            <!-- Metadata Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Job Information" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.JobDetail.State, Mode=OneWay}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Reveal Mode:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.JobDetail.RevealMode, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Input Format:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.JobDetail.InputFormat, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Input Size:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.JobDetail.InputSizeBytes, Mode=OneWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Retries / Reprocess:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.JobDetail.TechnicalRetryCount, Mode=OneWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Created UTC:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.JobDetail.CreatedAtUtc, Mode=OneWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Config Version:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.JobDetail.ConfigVersionId, Mode=OneWay}"/>

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Output Path:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.JobDetail.OutputPublishedPath, Mode=OneWay, FallbackValue='Pending'}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Checkpoints Timeline -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Checkpoints Timeline" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.JobDetail.Checkpoints, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:JobCheckpointDto">
                                <Grid Padding="8,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind StageName}" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ArtifactPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CreatedAtUtc}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
