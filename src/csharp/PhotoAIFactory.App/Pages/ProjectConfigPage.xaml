<Page
    x:Class="PhotoAIFactory.App.Pages.ProjectConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="20" Padding="0,0,0,40">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Project Configuration" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Edit Configuration" Command="{x:Bind ViewModel.StartEditCommand}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}"/>
                    <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{ThemeResource AccentButtonStyle}" Content="Save as New Version" Command="{x:Bind ViewModel.SaveConfigCommand}" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToBool}}"
                Severity="Informational"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Configuration Form -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Parameters" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                    <TextBox Header="Input Folder" Text="{x:Bind ViewModel.InputFolder, Mode=TwoWay}" IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InvertBool}}"/>
                    <TextBox Header="Output Folder" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}" IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InvertBool}}"/>

                    <CheckBox Content="Include subdirectories" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}"/>
                    <CheckBox Content="Preselection &amp; Culling" IsChecked="{x:Bind ViewModel.PreselectionEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsEditing, Mode=OneWay}"/>

                    <TextBox Header="Export Format" Text="{x:Bind ViewModel.ExportFormat, Mode=TwoWay}" IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InvertBool}}"/>
                    <TextBox Header="Export Quality (1-100)" Text="{x:Bind ViewModel.ExportQuality, Mode=TwoWay}" IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InvertBool}}"/>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="Config SHA-256 Hash:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.ConfigHashDisplay, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
