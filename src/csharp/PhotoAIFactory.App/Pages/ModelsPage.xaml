<Page
    x:Class="PhotoAIFactory.App.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoAIFactory.Application.UI"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,0,40">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Engines &amp; Model Catalogs" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Local AI models, renderers, and runtime status monitoring." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh Status" Command="{x:Bind ViewModel.RefreshCommand}"/>
            </Grid>

            <!-- Background Components / Engines -->
            <StackPanel Spacing="12">
                <TextBlock Text="Component Runtimes" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Components, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:ComponentHealthCardDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="2" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{x:Bind State}" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Model Policy Catalog -->
            <StackPanel Spacing="12">
                <TextBlock Text="Model Catalog &amp; Licenses" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:ModelDescriptorDto">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                        <Border Grid.Column="1" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind PolicyStatus}" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{x:Bind Purpose}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind LicenseNotice}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
