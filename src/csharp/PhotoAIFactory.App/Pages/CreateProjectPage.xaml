<Page
    x:Class="PhotoAIFactory.App.Pages.CreateProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="20" Padding="0,0,0,40">
            <StackPanel Spacing="4">
                <TextBlock Text="Create New Project" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Configure directory paths and processing pipeline parameters." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.ValidationError, Mode=OneWay, Converter={StaticResource NullToBool}}"
                Severity="Error"
                Title="Validation Error"
                Message="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                IsClosable="False" />

            <!-- General Settings -->
            <StackPanel Spacing="12">
                <TextBlock Text="General" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBox Header="Project Name" Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Wedding Session 2026"/>
            </StackPanel>

            <!-- Storage & Folders -->
            <StackPanel Spacing="12">
                <TextBlock Text="Storage Locations" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Input Folder (Watch Directory)" Text="{x:Bind ViewModel.InputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\Photos\Input"/>
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseInputFolder_Click"/>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Output Folder (Results)" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\Photos\Output"/>
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseOutputFolder_Click"/>
                </Grid>

                <CheckBox Content="Include subdirectories in ingestion" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Processing Pipeline -->
            <StackPanel Spacing="12">
                <TextBlock Text="Processing Pipeline" Style="{ThemeResource SubtitleTextBlockStyle}"/>

                <ComboBox Header="Reveal Mode" SelectedIndex="0" Width="300">
                    <ComboBoxItem Content="PRE_AI (Balanced AI Baseline)"/>
                    <ComboBoxItem Content="DT_AUTO (Darktable Native Auto)"/>
                    <ComboBoxItem Content="FEEDBACK (Dual-Pass Iterative)"/>
                </ComboBox>

                <CheckBox Content="Enable Preselection &amp; Culling" IsChecked="{x:Bind ViewModel.PreselectionEnabled, Mode=TwoWay}"/>

                <ComboBox Header="Semantic Analysis Mode" SelectedIndex="1" Width="300">
                    <ComboBoxItem Content="OFF"/>
                    <ComboBoxItem Content="STANDARD (Fast Florence-2)"/>
                    <ComboBoxItem Content="FULL (Deep Inspection)"/>
                </ComboBox>

                <ComboBox Header="ComfyUI Mode" SelectedIndex="0" Width="300">
                    <ComboBoxItem Content="OFF"/>
                    <ComboBoxItem Content="AUTO (Conservative Policy)"/>
                    <ComboBoxItem Content="ON (Approved Workflows Only)"/>
                </ComboBox>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                <Button Style="{ThemeResource AccentButtonStyle}" Content="Create &amp; Open Project" Command="{x:Bind ViewModel.CreateProjectCommand}"/>
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
