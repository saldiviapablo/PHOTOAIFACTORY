<Page
    x:Class="PhotoAIFactory.App.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:PhotoAIFactory.Application.UI"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBlock Text="Projects" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Select an existing project or create a new one to begin processing." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Command="{x:Bind ViewModel.LoadProjectsCommand}"/>
                <Button Style="{ThemeResource AccentButtonStyle}" Content="Create Project" Command="{x:Bind ViewModel.CreateNewProjectCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Projects List -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ListView
                x:Name="ProjectsListView"
                ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="ui:ProjectSummaryDto">
                        <Grid Padding="12" Margin="0,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16"/>
                                    <Border Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind State}" FontSize="11"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{x:Bind InputFolder}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind OutputFolder}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <TextBlock Text="{x:Bind TotalPhotos}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind CompletedJobs}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind PendingReviews}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" VerticalAlignment="Center" Content="Open" Style="{ThemeResource AccentButtonStyle}"
                                    Command="{Binding DataContext.OpenProjectCommand, ElementName=ProjectsListView}" CommandParameter="{x:Bind}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
