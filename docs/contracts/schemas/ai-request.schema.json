{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "job_id",
    "operation",
    "input_paths",
    "config"
  ],
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "object"
    }
  }
}
